# Provider API tokens for deploy/provision-free.py
#
#   cp deploy/tokens.env.example deploy/.secrets/tokens.env
#   chmod 600 deploy/.secrets/tokens.env
#
# `deploy/.secrets/` is git-ignored. The provisioning script masks every value
# it reads, so none of these ever appear in terminal output or logs.
#
# You do not need all of them at once — the script runs whichever steps it has
# credentials for and reports the rest as blocked.

# --- Supabase ---------------------------------------------------------------
# Account Settings -> Access Tokens -> Generate new token.
# Used to create the Postgres project via the Management API.
SUPABASE_ACCESS_TOKEN=

# The password for the new database. The script generates one if left blank,
# and writes it into the connection string it produces.
SUPABASE_DB_PASSWORD=

# Optional: skip project creation and use one that already exists.
# SUPABASE_PROJECT_REF=

# Storage S3 keys. These are created in the dashboard
# (Project Settings -> Storage -> S3 access keys); the Management API does not
# expose them. Paste them here once you have them.
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=

# --- Upstash ----------------------------------------------------------------
# Console -> Account -> Management API -> Create API key.
# The Upstash API authenticates with your account email plus the key.
UPSTASH_EMAIL=
UPSTASH_API_KEY=

# --- Render -----------------------------------------------------------------
# Account Settings -> API Keys -> Create API key.
RENDER_API_KEY=

# --- Resend -----------------------------------------------------------------
# API Keys -> Create API key (Sending access).
RESEND_API_KEY=

# The sender address. With no verified domain this must stay
# onboarding@resend.dev, which can ONLY deliver to the address that owns the
# Resend account — see DEPLOYMENT-FREE.md.
RESEND_FROM=onboarding@resend.dev

# --- GitHub -----------------------------------------------------------------
# Only needed if the script cannot pick up your existing git credentials.
# Requires the `repo` scope to set the Actions variable.
# GITHUB_TOKEN=
