# Copy to .env and adjust. Never commit a real .env.
#
# These defaults match the bundled docker-compose stack as seen FROM THE HOST
# (running the API with uvicorn locally). Inside docker-compose the API gets
# its own values from the compose file, where hostnames are service names.

# --- General ---------------------------------------------------------------
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Origins allowed to call the API from a browser (comma separated).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:19000

# Used to build links in verification / reset emails.
FRONTEND_BASE_URL=http://localhost:8081

# --- Security --------------------------------------------------------------
# REQUIRED in production: >=32 random chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot with APP_ENV=production while this is the default.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# --- Database --------------------------------------------------------------
# A managed provider gives you one connection string; it takes precedence over
# the discrete settings below. Supabase: use the SHARED POOLER host (port
# 6543) — the direct db.<ref>.supabase.co host is IPv6-only and unavailable on
# the free plan. The app auto-detects a transaction pooler and disables
# asyncpg's prepared-statement cache, which is required for correctness there.
# DATABASE_URL_OVERRIDE=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Force pooler-safe settings if your provider is not auto-detected:
# FORCE_POOLED_DATABASE=false

# 5434 is the host port docker-compose publishes for Postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=amora
POSTGRES_PASSWORD=amora
POSTGRES_DB=amora

# --- Redis -----------------------------------------------------------------
# Used for rate limiting and cross-worker WebSocket fan-out.
REDIS_URL=redis://localhost:6380/0

# --- Object storage (S3 compatible) ----------------------------------------
# Locally this is LocalStack's S3. For production set these to real S3,
# Cloudflare R2, or a MinIO cluster -- no code changes are needed.
S3_ENDPOINT_URL=http://localhost:4566
# The address clients use for presigned URLs. Differs from the above when the
# API runs inside Docker and the client does not.
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY=amoralocal
S3_SECRET_KEY=amoralocal
S3_BUCKET=amora-photos
S3_PRESIGN_TTL_SECONDS=900

# --- Email -----------------------------------------------------------------
# Transport: auto | resend | smtp | console
#   resend  — HTTPS API. REQUIRED on Render, which blocks outbound SMTP ports
#             (25/465/587) on every plan.
#   smtp    — any SMTP provider, and the local Mailpit container.
#   console — log instead of sending (development only).
EMAIL_TRANSPORT=auto
# RESEND_API_KEY=re_...
#
# NOTE: Resend's shared onboarding@resend.dev sender can only deliver to the
# address that owns the Resend account. Emailing real users needs a domain you
# have verified with them.

# Mailpit catches everything; read it at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@amora.dev
SMTP_USE_TLS=false
# If SMTP is unreachable, log the email instead of failing the request.
EMAIL_CONSOLE_FALLBACK=true

# --- Product rules ---------------------------------------------------------
MINIMUM_AGE=18
MAX_PHOTOS_PER_USER=6
DISCOVERY_PAGE_SIZE=20
# Require admin approval before a photo is publicly visible.
REQUIRE_PHOTO_MODERATION=true

# Require a confirmed email address before an account can be used.
# Turning this OFF lets a deployment with no verified sending domain accept
# real signups, at the cost of: no proof anyone owns their address, no
# password reset, and no obstacle to spam accounts. The API logs a warning on
# every boot while it is off. Demo setting, not a launch setting.
REQUIRE_EMAIL_VERIFICATION=true

# Publish chat events via Redis so they reach clients on another worker.
# Set false for a single-instance deployment (e.g. Render free): there is no
# other worker to reach, and not every managed Redis supports pub/sub over
# TCP. Chat then works in-process only — correct for one instance, silently
# broken for more than one.
WS_FANOUT_ENABLED=true

# --- Rate limits ("requests/window-seconds") -------------------------------
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_SWIPE=500/3600
RATE_LIMIT_MESSAGE=120/60
RATE_LIMIT_REPORT=20/86400
RATE_LIMIT_PASSWORD_RESET=5/3600
